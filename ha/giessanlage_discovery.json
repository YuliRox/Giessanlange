{
  "dev": {
    "ids": "giessanlage",
    "name": "Gießanlage",
    "mf": "YuliRox",
    "mdl": "ESP32-C6-DevKitC-1",
    "sw": "feature/mqtt-remote-commands"
  },
  "o": {
    "name": "claude-code-ha-bridge"
  },
  "cmps": {
    "pump1": {
      "p": "switch",
      "name": "Pump 1",
      "uniq_id": "giessanlage_pump1",
      "def_ent_id": "switch.giessanlage_pump_1",
      "cmd_t": "giessanlage/commands/ch1",
      "pl_on": "{\"cmd\":\"toggle_pump\"}",
      "pl_off": "{\"cmd\":\"toggle_pump\"}",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ 'OFF' if value_json.state_ch1 == 'Idle' else 'ON' }}",
      "stat_on": "ON",
      "stat_off": "OFF",
      "ic": "mdi:water-pump",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "pump2": {
      "p": "switch",
      "name": "Pump 2",
      "uniq_id": "giessanlage_pump2",
      "def_ent_id": "switch.giessanlage_pump_2",
      "cmd_t": "giessanlage/commands/ch2",
      "pl_on": "{\"cmd\":\"toggle_pump\"}",
      "pl_off": "{\"cmd\":\"toggle_pump\"}",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ 'OFF' if value_json.state_ch2 == 'Idle' else 'ON' }}",
      "stat_on": "ON",
      "stat_off": "OFF",
      "ic": "mdi:water-pump",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "pump1_duration": {
      "p": "number",
      "name": "Pump 1 duration",
      "uniq_id": "giessanlage_pump1_duration",
      "def_ent_id": "number.giessanlage_pump_1_duration",
      "cmd_t": "giessanlage/commands/ch1",
      "cmd_tpl": "{\"cmd\":\"set_timer\",\"time_ms\":{{ (value * 1000) | int }}}",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ (value_json.pump_time_ch1_ms / 1000) | int }}",
      "unit_of_meas": "s",
      "min": 1,
      "max": 600,
      "step": 1,
      "mode": "box",
      "ic": "mdi:timer-cog",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "pump2_duration": {
      "p": "number",
      "name": "Pump 2 duration",
      "uniq_id": "giessanlage_pump2_duration",
      "def_ent_id": "number.giessanlage_pump_2_duration",
      "cmd_t": "giessanlage/commands/ch2",
      "cmd_tpl": "{\"cmd\":\"set_timer\",\"time_ms\":{{ (value * 1000) | int }}}",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ (value_json.pump_time_ch2_ms / 1000) | int }}",
      "unit_of_meas": "s",
      "min": 1,
      "max": 600,
      "step": 1,
      "mode": "box",
      "ic": "mdi:timer-cog",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "watering_interval": {
      "p": "number",
      "name": "Watering interval",
      "uniq_id": "giessanlage_watering_interval",
      "def_ent_id": "number.giessanlage_watering_interval",
      "cmd_t": "giessanlage/config",
      "cmd_tpl": "{\"pump_time_ch1_ms\": {{ (states('number.giessanlage_pump_1_duration') | float(30) * 1000) | int }}, \"pump_time_ch2_ms\": {{ (states('number.giessanlage_pump_2_duration') | float(30) * 1000) | int }}, \"watering_interval_ms\": {{ (value * 3600000) | int }}, \"paused\": {{ 'true' if is_state('switch.giessanlage_pause_watering', 'on') else 'false' }}}",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ (value_json.watering_interval_ms / 3600000) | round(2) }}",
      "unit_of_meas": "h",
      "min": 0.1,
      "max": 168,
      "step": 0.1,
      "mode": "box",
      "retain": true,
      "ic": "mdi:calendar-clock",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "pause_watering": {
      "p": "switch",
      "name": "Pause watering",
      "uniq_id": "giessanlage_pause_watering",
      "def_ent_id": "switch.giessanlage_pause_watering",
      "cmd_t": "giessanlage/config",
      "cmd_tpl": "{\"pump_time_ch1_ms\": {{ (states('number.giessanlage_pump_1_duration') | float(30) * 1000) | int }}, \"pump_time_ch2_ms\": {{ (states('number.giessanlage_pump_2_duration') | float(30) * 1000) | int }}, \"watering_interval_ms\": {{ (states('number.giessanlage_watering_interval') | float(12) * 3600000) | int }}, \"paused\": {{ 'true' if value == 'ON' else 'false' }}}",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ 'ON' if value_json.paused else 'OFF' }}",
      "stat_on": "ON",
      "stat_off": "OFF",
      "retain": true,
      "ic": "mdi:pause-octagon",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "state_ch1": {
      "p": "sensor",
      "name": "Pump 1 state",
      "uniq_id": "giessanlage_state_ch1",
      "def_ent_id": "sensor.giessanlage_pump_1_state",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ value_json.state_ch1 }}",
      "ic": "mdi:state-machine",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "state_ch2": {
      "p": "sensor",
      "name": "Pump 2 state",
      "uniq_id": "giessanlage_state_ch2",
      "def_ent_id": "sensor.giessanlage_pump_2_state",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ value_json.state_ch2 }}",
      "ic": "mdi:state-machine",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "remaining_ch1": {
      "p": "sensor",
      "name": "Pump 1 remaining",
      "uniq_id": "giessanlage_remaining_ch1",
      "def_ent_id": "sensor.giessanlage_pump_1_remaining",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ (value_json.remaining_pump_ms_ch1 / 1000) | int }}",
      "unit_of_meas": "s",
      "ic": "mdi:timer-sand",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "remaining_ch2": {
      "p": "sensor",
      "name": "Pump 2 remaining",
      "uniq_id": "giessanlage_remaining_ch2",
      "def_ent_id": "sensor.giessanlage_pump_2_remaining",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ (value_json.remaining_pump_ms_ch2 / 1000) | int }}",
      "unit_of_meas": "s",
      "ic": "mdi:timer-sand",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "next_watering": {
      "p": "sensor",
      "name": "Next watering in",
      "uniq_id": "giessanlage_next_watering",
      "def_ent_id": "sensor.giessanlage_next_watering_in",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ (value_json.remaining_watering_ms / 60000) | int }}",
      "unit_of_meas": "min",
      "ic": "mdi:watering-can",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "next_watering_hms": {
      "p": "sensor",
      "name": "Next watering countdown",
      "uniq_id": "giessanlage_next_watering_hms",
      "def_ent_id": "sensor.giessanlage_next_watering_countdown",
      "stat_t": "giessanlage/status",
      "val_tpl": "{% set s = (value_json.remaining_watering_ms / 1000) | int %}{{ '%02d:%02d:%02d' | format(s // 3600, (s % 3600) // 60, s % 60) }}",
      "ic": "mdi:timer-outline",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "uptime": {
      "p": "sensor",
      "name": "Uptime",
      "uniq_id": "giessanlage_uptime",
      "def_ent_id": "sensor.giessanlage_uptime",
      "stat_t": "giessanlage/status",
      "val_tpl": "{{ (value_json.uptime_ms / 1000) | int }}",
      "unit_of_meas": "s",
      "dev_cla": "duration",
      "ent_cat": "diagnostic",
      "ic": "mdi:clock-outline",
      "avty_t": "giessanlage/availability",
      "pl_avail": "online",
      "pl_not_avail": "offline"
    },
    "online": {
      "p": "binary_sensor",
      "name": "Online",
      "uniq_id": "giessanlage_online",
      "def_ent_id": "binary_sensor.giessanlage_online",
      "stat_t": "giessanlage/availability",
      "pl_on": "online",
      "pl_off": "offline",
      "dev_cla": "connectivity",
      "ent_cat": "diagnostic"
    }
  }
}
