# Copy to `.devcontainer/.env` and adjust. Docker Compose auto-loads `.env` from this
# directory and substitutes these into docker-compose.yml. The real `.env` is gitignored
# so credentials are not committed. If absent, the defaults in docker-compose.yml apply.

# Mosquitto MQTT broker credentials (seeded into the password file at container start).
MQTT_USERNAME=tester
MQTT_PASSWORD=testpass
