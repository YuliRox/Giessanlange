; Copy this file to secrets.ini and fill in real values.
; secrets.ini is gitignored — never commit credentials.
;
; Empty values keep the device operating offline: WiFi will not associate
; and MQTT will not connect, but pumps and buttons still work locally.
; An empty ota_pass disables the LAN OTA listener entirely.

[secrets]
wifi_ssid =
wifi_pass =
mqtt_user =
mqtt_pass =
mqtt_broker =
ota_pass =
